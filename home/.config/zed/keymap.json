[
  {
    "context": "Pane",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-1": "pane::ActivatePreviousItem",
      "cmd-2": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": { "j j": "vim::NormalBefore" },
  },
  {
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "r": "project_panel::Rename",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "s": "project_panel::OpenPermanent",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-m": "editor::ToggleFold",
      "ctrl-n": "editor::SelectAllMatches",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space \\": "project_panel::CollapseAllEntries",
      // "space r": "tab_switcher::Toggle",
      "space d f": "git::Diff",
    },
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl+y": "git::ToggleStaged",
      "D": ["git::RestoreFile", { "skip_prompt": true }],
      "d": ["git::RestoreFile", { "skip_prompt": false }],
      "s": "git::StageFile",
    },
  },
  // MENU NAVIGATION USING CTRL+J/K
  {
    "context": "menu",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "KeybindEditorModal > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  // FOR CONTEXT MENUS : NAVIGATION USING CTRL+J/K
  {
    "context": "(Editor && (showing_code_actions || showing_completions))",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-j": "editor::MoveLineDown",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-down": "editor::MoveLineDown",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-up": "editor::MoveLineUp",
    },
  },
  {
    "context": "vim_mode == normal && Editor",
    "bindings": {
      "space g o": "git_graph::Open",
    },
  },

  // ==================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle", // should be git files
      "space /": "pane::DeploySearch",
      "space o": "outline::Toggle",
      // "space :": "", // vim command history
      // "space ,": "pane::ActivateNextItem",
      "space f b": "buffer_search::Deploy",
      "space f g": "pane::DeploySearch",
      // "space s w": "search::SelectAllMatches",
    },
  },
]
