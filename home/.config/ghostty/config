# ==== THEME ====
theme = light:Catppuccin Latte,dark:Catppuccin Frappe
# theme = light:Catppuccin Latte,dark:Catppuccin Macchiato
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ==== FONTS ====
# font-family = Ioskeley Mono
# Osaka Code is Apple's Osaka-Mono with the 372 glyphs it drew full-width
# (◯ ● → — “ ”, Greek, Cyrillic, box drawing) unmapped, so they fall back at
# one cell instead of bleeding into the next -- plus a repaired OS/2 table.
# Built by osaka-code.py in the font repo; plain `Osaka` is still installed to A/B.
font-family = Osaka Code
# font-family = CaskaydiaCove Nerd Font

window-save-state = always

# ==== FONT CUSTOMIZATION ====
font-size = 16
font-thicken = false
adjust-cell-height = 20%
font-feature = liga=0, calt=0

# ==== ALWAYS OPEN MAXIMIZED WINDOW ====
maximize = true

# ==== HIDE ANNOYING ICON IN TITLEBAR ====
macos-titlebar-proxy-icon = hidden

# ==== CURSOR & MOUSE SUPPORT ==== 
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# ==== CUSTOM KEYS ====
keybind = shift+enter=text:\n

# ==== BETTER LINK HANDLING ====
link-url = true

# ==== APP BEHAVIOR ====
app-notifications = no-clipboard-copy

# macos-icon = blueprint
macos-icon = chalkboard
